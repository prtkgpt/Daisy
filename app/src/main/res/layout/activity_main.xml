<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Sober Companion"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/textViewDaysSober"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="0 Days Sober"
        android:textSize="48sp"
        android:textColor="@color/purple_500"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/buttonCheckIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Check In / Reset"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/textViewAI"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="AI Companion: Hello! I'm here to support you on your journey. One day at a time."
        android:textSize="18sp"
        android:padding="16dp"
        android:background="#EEE"
        android:gravity="center"
        android:fontFamily="sans-serif-light"/>

</LinearLayout>
